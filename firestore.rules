rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: everyone can browse the catalog, but only a signed-in
    // admin (via Firebase Authentication) can add/edit/delete products.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: customers create orders through the secure server endpoint
    // (/api/orders/create) using Firebase Admin SDK.
    // Read is allowed so customers can track orders.
    // Update/delete is restricted to authenticated admins only.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if request.auth != null;
    }

    // Settings: publicly readable, only admin can edit
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Push subscriptions: clients can register their devices, but cannot read others
    match /push_subscriptions/{subId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Coupons: publicly readable for client cart validation, admin only writes
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customer review images
    match /reviewImages/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Shipping governorates & costs
    match /governorates/{govId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Realtime admin broadcast alerts
    match /admin_alerts/{alertId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Harmless connectivity probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // Analytics: write-only for visitors, read restricted to admin
    match /analytics_daily/{dateId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /analytics_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Fallback
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
