rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Products: readable and manageable across the store
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2. Orders: customers create orders, admin reads, updates and manages orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 3. Settings: store details, branding and shipping configuration
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 4. Admin credentials: secure access
    match /admin_auth/{authId} {
      allow read, write: if true;
    }

    // 5. Push Subscriptions & Tokens for Web Push notifications
    match /push_subscriptions/{subId} {
      allow read, write: if true;
    }

    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 6. Coupons
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // 7. Shipping governorates and rates
    match /governorates/{govId} {
      allow read, write: if true;
    }

    // 8. Realtime Admin Broadcast Alerts
    match /admin_alerts/{alertId} {
      allow read, write: if true;
    }

    // 9. Customer review images
    match /reviewImages/{reviewId} {
      allow read, write: if true;
    }

    // 10. Analytics
    match /analytics_daily/{dateId} {
      allow read, write: if true;
    }

    match /analytics_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
