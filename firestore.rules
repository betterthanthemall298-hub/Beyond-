rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Products: read by all customers, write/update/delete by admin only
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Orders: any customer can create a new order, but only admin can read, modify or delete orders
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 3. Settings: read by all customers, updated by admin only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Admin credentials: completely forbidden from frontend access under any circumstance
    match /admin_auth/{authId} {
      allow read, write: if false;
    }

    // 5. Push Subscriptions: devices can register/create subscriptions, but cannot read other devices' endpoints
    match /push_subscriptions/{subId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /fcm_tokens/{tokenId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 6. Coupons: read by all customers to validate discounts, created/updated by admin only
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 7. Shipping governorates: read by all, edited by admin only
    match /governorates/{govId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 8. Realtime Admin Broadcast Alerts (Instant cross-device push synchronization)
    match /admin_alerts/{alertId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // 9. Customer review images
    match /reviewImages/{reviewId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // 10. Analytics
    match /analytics_daily/{dateId} {
      allow read, write: if true;
    }

    match /analytics_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Default deny for any unspecified path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
