rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'vdbbdv1234567889@gmail.com' ||
        request.auth.token.email == 'eslsmgomaa47@gmail.com'
      );
    }

    // Public catalog data
    match /products/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /reviewImages/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /governorates/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}      { allow read: if true; allow write: if isAdmin(); }

    // Orders are created only by the server; only admins can read or change them
    match /orders/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Admin only
    match /coupons/{id}             { allow read, write: if isAdmin(); }
    match /push_subscriptions/{id}  { allow read, write: if isAdmin(); }
    match /private_settings/{id}    { allow read, write: if isAdmin(); }
    match /admin_alerts/{id}        { allow read: if isAdmin(); allow write: if false; }

    // Server only (everything else is denied by default)
    match /counters/{id}          { allow read, write: if false; }
    match /analytics_daily/{id}   { allow read, write: if false; }
    match /analytics_shards/{id}  { allow read, write: if false; }
    match /rate_limits/{id}       { allow read, write: if false; }
  }
}
