rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: catalog items can be read by visitors and managed by the store
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders: customers create orders, store management updates and tracks orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Store settings & shipping configurations
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Shipping governorates & costs
    match /governorates/{govId} {
      allow read, write: if true;
    }

    // Push subscriptions for order notifications
    match /push_subscriptions/{subId} {
      allow read, write: if true;
    }

    // Promotional coupons
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Customer review images
    match /reviewImages/{reviewId} {
      allow read, write: if true;
    }

    // Realtime admin alerts
    match /admin_alerts/{alertId} {
      allow read, write: if true;
    }

    // Harmless connectivity test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Store analytics
    match /analytics_daily/{dateId} {
      allow read, write: if true;
    }

    match /analytics_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Fallback catch-all for any store collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
