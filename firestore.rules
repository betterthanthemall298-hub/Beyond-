rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'vdbbdv1234567889@gmail.com' ||
        request.auth.token.email == 'eslsmgomaa47@gmail.com'
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /governorates/{govId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviewImages/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    match /push_subscriptions/{subId} {
      allow read, write: if isAdmin();
    }

    match /private_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_daily/{dateId} {
      allow read, write: if false;
    }

    match /analytics_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }
  }
}
