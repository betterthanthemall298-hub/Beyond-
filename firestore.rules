rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Public catalog data
    match /products/{id=**}      { allow read: if true; allow write: if isAdmin(); }
    match /reviewImages/{id=**}  { allow read: if true; allow write: if isAdmin(); }
    match /governorates/{id=**}  { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id=**}      { allow read: if true; allow write: if isAdmin(); }

    // Orders: allow create and read/write for orders
    match /orders/{id=**} {
      allow read, write: if true;
    }

    // Coupons: public can read to validate in cart; only admins can modify
    match /coupons/{id=**}             { allow read: if true; allow write: if isAdmin(); }
    match /push_subscriptions/{id=**}  { allow read, write: if true; }
    match /private_settings/{id=**}    { allow read, write: if isAdmin(); }
    match /admin_alerts/{id=**}        { allow read, write: if true; }

    // Counters and Analytics
    match /counters/{id=**}          { allow read, write: if true; }
    match /analytics_daily/{id=**}   { allow read, write: if true; }
    match /analytics_shards/{id=**}  { allow read, write: if true; }
    match /rate_limits/{id=**}       { allow read, write: if true; }
  }
}
